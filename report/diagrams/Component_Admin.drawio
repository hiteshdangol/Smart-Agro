        <mxCell id="n3" value="&lt;i&gt;Mongoose ODM&lt;/i&gt;" style="html=1;endArrow=block;strokeWidth=1.5;fontSize=11;fontStyle=2" edge="1" parent="1" source="c_admbe" target="c_admmongo"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="n4" value="&lt;i&gt;queries / aggregates&lt;/i&gt;" style="html=1;endArrow=block;strokeWidth=1.5;fontSize=11;fontStyle=2" edge="1" parent="1" source="c_admbe" target="c_admaudit"><mxGeometry relative="1" as="geometry" /></mxCell>
