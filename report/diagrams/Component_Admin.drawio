        <mxCell id="legend" value="&lt;b&gt;RBAC FLOW&lt;/b&gt;&lt;hr size=&quot;1&quot;&gt;Request &amp;#8594; authMiddleware (JWT) &amp;#8594;&lt;br&gt;permissionMiddleware (role + override) &amp;#8594;&lt;br&gt;controller &amp;#8594; model.&lt;br&gt;Permissions resolved from user role &amp;#8746; overrides." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;fontSize=11" vertex="1" parent="1">
