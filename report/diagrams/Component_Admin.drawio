        <mxCell id="c_admaudit" value="&lt;b&gt;&amp;#171;View&amp;#187; Admin Dashboard reports&lt;/b&gt;&lt;hr size=&quot;1&quot;&gt;farmer list with product counts&lt;br&gt;recent records (getAllCrop)&lt;br&gt;order overview&lt;br&gt;medicine database search" style="shape=component;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontSize=11;verticalAlign=top;align=left;spacingLeft=10;spacingRight=10" vertex="1" parent="1">
          <mxGeometry x="1100" y="560" width="230" height="190" as="geometry" />
