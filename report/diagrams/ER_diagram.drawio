        <mxCell id="title" value="&lt;b&gt;ENTITY RELATIONSHIP DIAGRAM - SMART AGRO SYSTEM&lt;/b&gt;" style="text;html=1;align=center;verticalAlign=middle;fontSize=18;fontColor=#000000;fontStyle=1" vertex="1" parent="1">
