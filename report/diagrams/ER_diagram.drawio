        </mxCell>

        <mxCell id="legend" value="&lt;b&gt;LEGEND&lt;/b&gt;&lt;hr size=&quot;1&quot;&gt;PK  = Primary Key (underlined)&lt;br&gt;FK  = Foreign Key&lt;br&gt;UQ  = Unique&lt;br&gt;&amp;#8656;   = One (crow's foot &quot;1&quot;)&lt;br&gt;&amp;#8658;   = Many (crow's foot &quot;N&quot;)&lt;br&gt;[String] = Array&lt;br&gt;Relationships: &quot;1 : M&quot; = one-to-many" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;fontSize=11;spacing=4" vertex="1" parent="1">
          <mxGeometry x="90" y="980" width="430" height="130" as="geometry" />
        </mxCell>

        <mxCell id="role" value="&lt;b&gt;ROLE&lt;/b&gt;&lt;hr size=&quot;1&quot;&gt;&lt;u&gt;_id : ObjectId (PK)&lt;/u&gt;&lt;br&gt;name : String (UQ)&lt;br&gt;description : String&lt;br&gt;permissions : [String]&lt;br&gt;isDefault : Boolean&lt;br&gt;createdAt / updatedAt : Date" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=8;fontSize=11" vertex="1" parent="1">
          <mxGeometry x="90" y="120" width="240" height="150" as="geometry" />
        </mxCell>

        <mxCell id="farmer" value="&lt;b&gt;FARMER (USER)&lt;/b&gt;&lt;hr size=&quot;1&quot;&gt;&lt;u&gt;_id : ObjectId (PK)&lt;/u&gt;&lt;br&gt;name : String (required)&lt;br&gt;email : String (UQ)&lt;br&gt;password : String (bcrypt hash)&lt;br&gt;role : String (default 'Farmer')&lt;br&gt;permissionsOverride : [String]&lt;br&gt;profilePicture : String&lt;br&gt;isBlocked : Boolean&lt;br&gt;farmName : String&lt;br&gt;location : String&lt;br&gt;verificationStatus : String&lt;br&gt;createdAt / updatedAt : Date" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=8;fontSize=11" vertex="1" parent="1">
          <mxGeometry x="90" y="420" width="240" height="270" as="geometry" />
