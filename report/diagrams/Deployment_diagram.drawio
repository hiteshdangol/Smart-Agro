        <mxCell id="node_browser" value="&lt;b&gt;&amp;#171;device&amp;#187; Client Browser&lt;/b&gt;&lt;hr size=&quot;1&quot;&gt;React SPA (user &amp;amp; admin)&lt;br&gt;localhost:3000" style="shape=browser;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontSize=11;verticalAlign=top;spacing=6" vertex="1" parent="1">
          <mxGeometry x="60" y="120" width="240" height="130" as="geometry" />
        </mxCell>

        <mxCell id="node_machine" value="&lt;b&gt;&amp;#171;device&amp;#187; Development Machine&lt;/b&gt;&lt;hr size=&quot;1&quot;&gt;Runs the frontend, backend, and ML microservices" style="swimlane;whiteSpace=wrap;html=1;fillColor=#f0f0f0;strokeColor=#000000;startSize=30;fontStyle=1;fontSize=12" vertex="1" parent="1">
          <mxGeometry x="430" y="100" width="560" height="760" as="geometry" />
