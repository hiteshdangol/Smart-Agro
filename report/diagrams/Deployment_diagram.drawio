        <mxCell id="node_pest" value="&lt;b&gt;&amp;#171;artifact&amp;#187; ML Pest Service&lt;/b&gt;&lt;hr size=&quot;1&quot;&gt;FastAPI (api_nb.py)&lt;br&gt;Naive Bayes + joblib&lt;br&gt;&lt;b&gt;port 5002&lt;/b&gt;" style="shape=server;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontSize=10;verticalAlign=top" vertex="1" parent="1">
