        <mxCell id="note" value="&lt;b&gt;NOTE&lt;/b&gt;&lt;hr size=&quot;1&quot;&gt;All services run on one development machine in the&lt;br&gt;current local deployment. The eSewa gateway is reached&lt;br&gt;over the internet." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;fontSize=11" vertex="1" parent="1">
