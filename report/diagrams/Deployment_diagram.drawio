        <mxCell id="node_crop" value="&lt;b&gt;&amp;#171;artifact&amp;#187; ML Crop Service&lt;/b&gt;&lt;hr size=&quot;1&quot;&gt;FastAPI (crop_recommendataion_knn.py)&lt;br&gt;Random Forest + pkl&lt;br&gt;&lt;b&gt;port 5003&lt;/b&gt;" style="shape=server;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontSize=10;verticalAlign=top" vertex="1" parent="1">
