        <mxCell id="node_fe" value="&lt;b&gt;&amp;#171;executionEnvironment&amp;#187; Frontend Server&lt;/b&gt;&lt;hr size=&quot;1&quot;&gt;Node + React Dev Server&lt;br&gt;&lt;b&gt;port 3000&lt;/b&gt;" style="shape=server;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontSize=11;verticalAlign=top" vertex="1" parent="1">
